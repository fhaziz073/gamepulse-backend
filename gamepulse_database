CREATE TABLE public."User Table" (
    "User ID" uuid NOT NULL,
    "Avatar URL" text,
    "Creation Time" timestamp with time zone,
    "Password" character varying,
    "Notification Token" character varying,
    "Username" text,
    "Email" text
);

CREATE TABLE public."Preference Table" (
    "User ID" uuid,
    "Games Starting Notif Pref" boolean,
    "Ongoing Close Games Notif Pref" boolean,
    "Favorite Teams" json,
    "Favorite Players" json
);

CREATE TABLE public."Team Table" (
    id integer,
    name text,
    full_name text,
    abbreviation text,
    city text,
    conference text,
    division text,
    hex_code text
);

CREATE TABLE public."Game Table" (
    id integer,
    date text,
    "Home Team ID" integer,
    "Away Team ID" integer,
    season integer,
    home_q1 integer,
    home_q2 integer,
    home_q3 integer,
    home_q4 integer,
    home_ot1 integer,
    home_ot2 integer,
    home_ot3 integer,
    visitor_q1 integer,
    visitor_q2 integer,
    visitor_q3 integer,
    visitor_q4 integer,
    visitor_ot1 integer,
    visitor_ot2 integer,
    visitor_ot3 integer,
    home_team_score integer,
    visitor_team_score integer,
    postseason boolean,
    postponed boolean
);

CREATE TABLE public."Player Table" (
    id integer,
    first_name text,
    last_name text,
    "position" text,
    height text,
    weight text,
    jersey_number text,
    college text,
    country text,
    draft_year integer,
    draft_round integer,
    draft_number integer
);

CREATE TABLE public."Betting Table" (
    id integer,
    game_id integer,
    vendor text,
    spread_home_value text,
    spread_home_odds integer,
    spread_away_value text,
    spread_away_odds integer,
    moneyline_home_odds integer,
    moneyline_away_odds integer,
    total_value text,
    total_over_odds integer,
    total_under_odds integer
);

ALTER TABLE ONLY public."User Table"
    ADD CONSTRAINT "Unique Email" UNIQUE ("Email");

ALTER TABLE ONLY public."User Table"
    ADD CONSTRAINT "Unique Username" UNIQUE ("Username");

ALTER TABLE ONLY public."User Table"
    ADD CONSTRAINT "User Table_pkey" PRIMARY KEY ("User ID");